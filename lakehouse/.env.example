# Copy to .env and replace every CHANGE_ME. .env is git-ignored; never commit it.
# Generate passwords with:  openssl rand -base64 24

# Postgres superuser (setup only) and the two DuckLake catalog roles
POSTGRES_PASSWORD=CHANGE_ME
# Writers: the loader, later the scheduler
LAKE_RW_PASSWORD=CHANGE_ME
# Readers: Superset, Cube, ad hoc queries
LAKE_RO_PASSWORD=CHANGE_ME

# Dagster's run storage (the dagster database on catalog-pg)
DAGSTER_PG_PASSWORD=CHANGE_ME

# Jupyter login token
JUPYTER_TOKEN=CHANGE_ME

# Cube: the secret that signs its REST API tokens, and the password for its SQL API (user "lake")
CUBEJS_API_SECRET=CHANGE_ME
CUBE_SQL_PASSWORD=CHANGE_ME

# Superset: the key that signs its sessions, its metadata database password, and the admin user's password
# (user "admin"; read it in your own SSH session, never in chat)
SUPERSET_SECRET_KEY=CHANGE_ME
SUPERSET_PG_PASSWORD=CHANGE_ME
SUPERSET_ADMIN_PASSWORD=CHANGE_ME

# MCP server (Phase 4): the bearer token clients send to https://<LAKE_TS_HOST>/mcp
MCP_TOKEN=CHANGE_ME

# OpenMetadata (Phase 5): its database role, its admin login, and the key that encrypts stored secrets
OM_DB_PASSWORD=CHANGE_ME
OM_ADMIN_PASSWORD=CHANGE_ME
OM_FERNET_KEY=CHANGE_ME
OM_MCP_PASSWORD=CHANGE_ME   # the MCP server's read-only OpenMetadata account (mcp-reader)
# Fuseki (Phase 5): the writer user's password; reads need none
FUSEKI_WRITER_PASSWORD=CHANGE_ME
# Grafana (Phase 6): the admin login's password, applied when Grafana first creates its database
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# postgres-exporter's role on catalog-pg (lake_monitor: statistics only)
LAKE_MONITOR_PASSWORD=CHANGE_ME
# The nightly catalog backup's role (lake_backup: reads every database, writes nothing)
LAKE_BACKUP_PASSWORD=CHANGE_ME

# Dagster UI login (Caddy basic auth). Don't edit by hand: run  bash scripts/set-dagster-ui-password.sh
# DAGSTER_UI_USER=admin
# DAGSTER_UI_HASH='$2a$14$...'

# Where the data disk is mounted on the VM
LAKE_ROOT=/lake

# This VM's Tailscale name. The sites are served at https://<LAKE_TS_HOST>/jupyter/ and /dagster/ with a real
# certificate from Tailscale. scripts/bootstrap.sh fills this in from `tailscale status`; leave it unset here.
# LAKE_TS_HOST=<this VM's Tailscale name, from `tailscale status`>

# Image tags are pinned in compose.yaml and the Dockerfiles (each an exact release at least two weeks old). To try
# another, add e.g. CADDY_TAG=2.11.8 here: an exact release, never latest or a bare major (bootstrap.sh flags those).
